{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/info",
        "destination": "/infohub.html"
      },
      {
        "source": "/recruiter",
        "destination": "/recruiterhub.html"
      }
    ]
  }
}
